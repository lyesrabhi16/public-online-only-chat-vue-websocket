{
  "name": "public-online-only-chat",
  "private": true,
  "version": "1.0.0",
  "description": "Live-only public chat rooms: Vue 3 + Socket.IO. Nothing said is ever stored.",
  "type": "module",
  "scripts": {
    "dev-server": "nodemon server.js",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "vue": "^3.5.10"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "nodemon": "^3.1.7",
    "typescript": "^5.5.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.6"
  }
}
